function lib:CodeBox(parent,text,settings)
	settings = clean(settings or {})

	if not settings.nocheck then
		if check(parent,text) then
			return
		end
	end

	local cbc = settings.style and cb_configs[settings.style] or cb_configs.studio
	local ptext = settings.text or ""

	local row = Instance.new("ScrollingFrame")
	row.Size = settings.size or UDim2.new(1,0,0,200)
	row.BorderSizePixel = 0

	local bg = Color3.fromHex(cbc["Background"])
	row.BackgroundColor3 = Color3.fromHex(cbc["Background"])
	row.ScrollBarImageColor3 = Color3.fromRGB(math.min(bg.R * 255 + 54, 255),math.min(bg.G * 255 + 54, 255),math.min(bg.B * 255 + 54, 255)) -- I was too lazy to do it manually or with a python script
	row.ScrollBarThickness = 0
	row.Parent = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0,4)
	corner.Parent = row

	local textbox = Instance.new("TextBox",row)
	textbox.Size = UDim2.new(0.98,0,1,0)
	textbox.Position = UDim2.new(0,6,0,0)
	textbox.BackgroundTransparency = 1
	textbox.TextSize = settings.textS
	--textbox.TextWrapped = true
	textbox.TextXAlignment = Enum.TextXAlignment.Left
	textbox.TextYAlignment = Enum.TextYAlignment.Top
	textbox.PlaceholderText = ptext
	textbox.Font = Enum.Font.Code
	textbox.RichText = true
	textbox.MultiLine = true
	textbox.Text = text
	textbox.TextColor3 = settings.text1
	textbox.ClearTextOnFocus = settings.clear or false
	textbox.TextEditable = not (settings.display or false)

	local faketext = textbox:Clone()
	faketext.TextEditable = false
	faketext.Interactable = false
	faketext.Parent = row
	
	local propertySet = {}
	local objectSet = {}
	local literalSet = {}
	local biPropertySet = {}

	for _, v in ipairs(property) do
		propertySet[v] = true
	end

	for _, v in ipairs(object) do
		objectSet[v] = true
	end

	for v in pairs(literal) do
		literalSet[v] = true
	end

	for _, v in ipairs(bi_property) do
		biPropertySet[v] = true
	end

	local function update()
		local t = textbox.Text
		--t = t:gsub("<font.->", ""):gsub("</font>", "")

		local function e(s)
			return s:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
		end

		local function c(s, col)
			return '<font color="' .. col .. '">' .. e(s) .. "</font>"
		end

		local function highlight(source)
			local out = {}
			local buffer = {}
			local bufferColor

			local function flush()
				if #buffer == 0 then
					return
				end

				local x = table.concat(buffer)
				out[#out + 1] = '<font color="' .. bufferColor .. '">' .. e(x) .. "</font>"

				table.clear(buffer)
			end

			local function add(x, color)
				if bufferColor ~= color then
					flush()
					bufferColor = color
				end

				buffer[#buffer + 1] = x
			end

			local i = 1

			while i <= #source do
				local s = source:sub(i)
				if s:sub(1, 2) == "--" then
					flush()

					local x
					if s:sub(1, 4) == "--[[" then
						local z = s:find("]]", 5, true)
						x = z and s:sub(1, z + 1) or s
					else
						local a = s:find("\n", 1, true)
						x = a and s:sub(1, a - 1) or s
					end

					out[#out + 1] = c(x, cbc["Comment"])
					i += #x
				elseif s:sub(1, 1) == '"' or s:sub(1, 1) == "'" then
					flush()

					local q, j = s:sub(1, 1), 2
					while j <= #s do
						if s:sub(j, j) == "\\" then
							j += 2
						elseif s:sub(j, j) == q then
							j += 1
							break
						else
							j += 1
						end
					end

					local x = s:sub(1, j - 1)
					out[#out + 1] = c(x, cbc["String"])
					i += #x
				elseif s:sub(1, 1) == "`" then
					flush()

					local j, x = 2, "`"
					while j <= #s do
						if s:sub(j, j) == "\\" then
							x ..= s:sub(j, j + 1)
							j += 2
						elseif s:sub(j, j) == "`" then
							x ..= "`"
							j += 1
							break
						elseif s:sub(j, j) == "{" then
							local start, depth = j, 1
							j += 1

							while j <= #s and depth > 0 do
								if s:sub(j, j) == "{" then
									depth += 1
								elseif s:sub(j, j) == "}" then
									depth -= 1
								end

								j += 1
							end

							local expr = s:sub(start, j - 1)

							x ..= '<font color="' .. cbc["Interpolation"] .. '">{</font>'
							x ..= highlight(expr:sub(2, -2))
							x ..= '<font color="' .. cbc["Interpolation"] .. '">}</font>'
						else
							x ..= e(s:sub(j, j))
							j += 1
						end
					end

					out[#out + 1] = '<font color="' .. cbc["String"] .. '">' .. x .. "</font>"
					i += j - 1
				elseif s:sub(1, 2) == "[[" then
					flush()

					local z = s:find("]]", 3, true)
					local x = z and s:sub(1, z + 1) or s

					out[#out + 1] = c(x, cbc["String"])
					i += #x
				elseif s:match("^%d") then
					flush()

					local x = s:match("^[%w%.]+")
					out[#out + 1] = c(x, cbc["Number"])
					i += #x
				elseif s:match("^[%a_]") then
					local x = s:match("^[%w_]+")
					local before = source:sub(math.max(1, i - 100), i - 1)
					local rest = s:sub(#x + 1)

					local isProperty = before:match("%.%s*$") ~= nil
					local previousWord = before:match("([%w_]+)%s*%.$")

					local col
					if literalSet[x] then
						col = cbc["Literal"]
					elseif previousWord and bi[previousWord] and biPropertySet[x] then
						col = cbc["BuiltinProperty"]
					elseif bi[x] and not isProperty then
						col = cbc["Builtin"]
					elseif rest:match("^%s*%(") then
						col = cbc["Function"]
					elseif isProperty and propertySet[x] then
						col = cbc["Property"]
					elseif isProperty then
						col = cbc["Object"]
					elseif before:match(":%s*$") then
						col = cbc["Type"]
					elseif kw[x] then
						col = cbc["Keyword"]
					else
						col = cbc["Default"]
					end

					add(x, col)
					i += #x
				else
					add(s:sub(1, 1), cbc["Operator"])
					i += 1
				end
			end

			flush()

			return table.concat(out)
		end

		row.CanvasSize = UDim2.new(0, 0, 0, textbox.TextBounds.Y + (settings.spacing or 60))

		local final = highlight(t)

		if #final < 200000 then
			faketext.Text = final
		else
			warn(err, "Code is too long. Formatting won't be applied.")
		end
	end

	textbox:GetPropertyChangedSignal("Text"):Connect(update)
	--textbox:GetPropertyChangedSignal("TextBounds"):Connect(update)
	--textbox:GetPropertyChangedSignal("ContentText"):Connect(update)
	update()

	textbox.FocusLost:Connect(function(bool)
		if settings.requireEnter and not bool then return end
		if settings.callback then settings.callback(textbox.Text) end
	end)

	textbox:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		row.CanvasSize = UDim2.new(0, 0, 0, textbox.TextBounds.Y + (settings.spacing or 60))
	end)

	local hovered = false
	row.MouseEnter:Connect(function()
		hovered = true
		local t = TS:Create(row,TweenInfo.new(.1),{ScrollBarThickness = 4})
		t:Play()
		t.Completed:Wait()
		if not hovered then
			row.ScrollBarThickness = 4
		end
	end)
	row.MouseLeave:Connect(function()
		hovered = false
		local t = TS:Create(row,TweenInfo.new(.1),{ScrollBarThickness = 0})
		t:Play()
		t.Completed:Wait()
		if hovered then
			row.ScrollBarThickness = 4
		end
	end)

	settings.outline1 = Color3.fromHex(cbc["Inner"])
	settings.outline0 = Color3.fromHex(cbc["Outer"])
	outline(row,.5,.5,true,settings)
	track(parent,row)

	return textbox
end

function layoutNotifications(X, SPACING)
	local order = {}

	for i,v in pairs(notifications) do
		if v and v.window then
			table.insert(order,{index = i,data = v})
		end
	end

	table.sort(order,function(a,b)
		return a.index > b.index
	end)

	for slot,v in ipairs(order) do
		local target = UDim2.new(1,-(X + 10),1,-(slot * SPACING))
		if v.data.tween then v.data.tween:Cancel() end
		v.data.tween = TS:Create(v.data.window,TweenInfo.new(.5,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Position = target})
		v.data.tween:Play()
	end
end

function lib:Notify(parent,length,settings)
	settings = clean(settings or {})

	if not settings.nocheck then
		if check(parent,length) then
			return
		end
	end

	local alignX = settings.alignmentX or Enum.TextXAlignment.Left
	local alignY = settings.alignmentY or Enum.TextYAlignment.Center
	local scaled = settings.textscaled and true or false
	local btntype = settings.btntype or 0
	local title = settings.title or "Notification"
	local text = settings.text or ""
	local X = settings.X or 300
	local Y = settings.Y or 100

	local api = {current = 0,total = length}
	local SPACING = Y + 10

	notificationIndex += 1
	local index = notificationIndex

	local window,content = lib:Window(parent,title,UDim2.new(0,X,0,Y),{symbol = settings.notification,color = Color3.fromRGB(30,30,30),position = UDim2.new(1,0,1,-SPACING),collapsable = false,closeable = true,noscroll = true})
	local label = btntype ~= 5 and lib:Label(content,text,{size = UDim2.new(1,0,0,Y - settings.headerS - settings.elementS - 13),nospace = true,textscaled = scaled,alignmentX = alignX,alignmentY = alignY}) or nil

	local function btn(parent,text,result)
		lib:Button(parent,text,{alignmentX = Enum.TextXAlignment.Center,
			callback = function()
				api.current = api.total

				if settings.callback then
					settings.callback(result,text)
				end
			end,
		})
	end

	if btntype == 0 then
		label.Size = UDim2.new(1,0,1,0)
		label.TextScaled = true
	else
		if btntype == 1 then
			btn(content,"OK",1)
		else
			local cols1 = lib:Holder(content,{padding = UDim.new(0,6)})

			if btntype == 2 or btntype == 3 then
				local left = lib:Column(cols1,.49,Enum.HorizontalAlignment.Left)
				local right = lib:Column(cols1,.49,Enum.HorizontalAlignment.Right)

				btn(left,btntype == 2 and "OK" or "YES",1)
				btn(right,btntype == 2 and "CANCEL" or "NO",2)
			elseif btntype == 4 then
				local left = lib:Column(cols1,.32,Enum.HorizontalAlignment.Left)
				local center = lib:Column(cols1,.32,Enum.HorizontalAlignment.Center)
				local right = lib:Column(cols1,.32,Enum.HorizontalAlignment.Right)

				btn(left,"YES",1)
				btn(center,"NO",2)
				btn(right,"CANCEL",3)
			end
		end
	end

	notifications[index] = {window = window,height = SPACING,tween = nil}

	zindexthingy(window,dropdownamount + 3)

	layoutNotifications(X,SPACING)

	task.spawn(function()
		while api.current < api.total do
			task.wait(.1)
			api.current += .1
		end

		local notif = notifications[index]

		if notif and notif.tween then
			notif.tween:Cancel()
		end

		local t = TS:Create(window, TweenInfo.new(.5,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Position = UDim2.new(1,0,1,window.Position.Y.Offset)})

		t:Play()

		notifications[index] = nil

		layoutNotifications(X,SPACING)

		t.Completed:Wait()
		window:Destroy()
	end)

	return window,content,api
end

function lib:Tab(parent,title,settings)
	settings = clean(settings or {})

	if not settings.nocheck then
		if check(parent,title) then
			return
		end
	end

	local content = parent.Content

	local tabs = parent:FindFirstChild("Tabs")
	if not tabs then
		tabs = Instance.new("Frame")
		tabs.Name = "Tabs"
		tabs.BorderSizePixel = 0
		tabs.Size = UDim2.new(1,0,0,settings.tabS)
		tabs.Position = UDim2.new(0,0,0,parent:FindFirstChild("Header") and parent.Header.Size.Y.Offset or 0)
		tabs.BackgroundColor3 = parent:FindFirstChild("Header") and settings.header or settings.background
		tabs.Parent = parent

		content.Size -= UDim2.new(0,0,0,tabs.Size.Y.Offset)
		content.Position += UDim2.new(0,0,0,tabs.Size.Y.Offset)
	end

	local tabsContents = parent:FindFirstChild("TabsContents")
	if not tabsContents then
		tabsContents = Instance.new("Frame")
		tabsContents.Name = "TabsContents"
		tabsContents.Size = content.Size
		tabsContents.BorderSizePixel = 0
		tabsContents.Position = content.Position
		tabsContents.BackgroundTransparency = 1
		tabsContents.Parent = parent
		content.Visible = false
	end

	local tabContent = settings.noscroll and Instance.new("Frame") or Instance.new("ScrollingFrame")
	local list = content.UIListLayout:Clone()
	list.Parent = tabContent
	tabContent.BorderSizePixel = 0
	tabContent.ScrollBarThickness = 0
	tabContent.ScrollBarImageColor3 = settings.scrollbar
	tabContent.Size = UDim2.new(1,0,1,0)
	tabContent.BackgroundTransparency = 1
	tabContent.Parent = tabsContents
	tabContent.Visible = false

	if not settings.noscroll then
		list:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
			tabContent.CanvasSize = UDim2.new(0,0,0,list.AbsoluteContentSize.Y)
		end)
	end

	if not settings.nobar and not settings.noscroll then
		local hovered = false

		tabContent.MouseEnter:Connect(function()
			hovered = true
			local t = TS:Create(tabContent,TweenInfo.new(.1),{ScrollBarThickness = 4})
			t:Play()
			t.Completed:Wait()
			if not hovered then
				tabContent.ScrollBarThickness = 4
			end
		end)

		tabContent.MouseLeave:Connect(function()
			hovered = false
			local t = TS:Create(tabContent,TweenInfo.new(.1),{ScrollBarThickness = 0})
			t:Play()
			t.Completed:Wait()
			if hovered then
				tabContent.ScrollBarThickness = 4
			end
		end)
	end

	local tab

	local function setTab()
		for _,v in pairs(tabs:GetChildren()) do
			if v.TextButton:FindFirstChild("Content") then
				v.TextButton.Content.Value.Visible = false -- was :GetAttribute("Content"):Get() before 1.5.4.1
			end

			for _,v in pairs(v.TextButton:GetChildren()) do
				if v:IsA("UIStroke") then
					v.Transparency = .5
				end
			end
			v.TextButton.BackgroundColor3 = settings.button1
			v.TextButton:SetAttribute("Inactive",false)
		end

		tabContent.Visible = true
		tab:SetAttribute("Inactive",true)
		tab.BackgroundColor3 = settings.header

		for _,v in pairs(tab:GetChildren()) do
			if v:IsA("UIStroke") then
				v.Transparency = 1
			end
		end

		for _,v in pairs(parent.Parent:GetChildren()) do
			if v:GetAttribute("Floating") then
				v:Destroy()
			elseif v:GetAttribute("FloatingV") then
				v.Visible = false
			end
		end
	end

	tab = lib:Button(tabs,title,{alignmentX = Enum.TextXAlignment.Center,callback = setTab})
	local ct = Instance.new("ObjectValue",tab)
	ct.Value = tabContent
	ct.Name = "Content"
	tab:SetAttribute("Inactive",false)

	local result = 1 / #tabs:GetChildren()
	local val = 0

	for _,v in pairs(tabs:GetChildren()) do
		v.Size = UDim2.new(result,0,1,0)
		v.Position = UDim2.new(val,0,0,0)
		val += result
	end

	return tab,tabContent,{setTab = setTab}
end

