function check(...)
	local t = debug and debug.traceback and debug.traceback()
	if not t then return warn(err, "Traceback couldn't be solved.") end

	local fn
	for v in t:gmatch("function%s+([%w_]+)") do
		if v ~= "check" then
			fn = v
			break
		end
	end

	--[[ removed in 1.5.9
	if not began and fn ~= "Begin" then
		return warn(err, "Script must start with Library:Begin()")
	end
	]]

	local expected = syntaxes[fn]
	if not expected then warn("Skira is a dumbass, tell him about this error") return end

	local args = {...}

	for i,v in pairs(args) do
		-- exceptions
		if expected[i] == "Content" and (v.ClassName == "Frame" or v.ClassName == "ScrollingFrame") then
			continue -- the parent of each ui element is the window's content frame who can be either a Frame or a ScrollingFrame
		end
		if expected[i] == "Scale" and (typeof(v) == "UDim2" or typeof(v) == "number") then
			continue -- columns can be given a number used as the scale but also UDim2 after 1.5.5
		end

		-- fallback
		local resolved = typeof(v) == "Instance" and v.ClassName or typeof(v)
		if resolved ~= expected[i] then
			warn(err, "Invalid argument #"..i.." to "..fn.." (Expected "..expected[i]..", got "..resolved..")")
			return true
		end
	end

	for i,v in pairs(expected) do
		if args[i] == nil then
			warn(err, "Missing argument #"..i.." to "..fn)
			return true
		end
	end

	--[[
	local missing = {}

	for i = 1, #expected do
		if args[i] == nil then
			table.insert(missing, expected[i])
		end
	end

	if #missing > 0 then
		game.TestService:Message(string.format("\n%s The following argument(s) are missing: %s\n%s Correct Syntax: lib:%s(%s)\n%s If you need help, refer to https://skira.me/lua/SkiraLibrary",err,table.concat(missing, ", "),inf,fn,table.concat(expected, ", "),inf))
	end
	]]
end

function track(dad,obj)
	if tracker[dad] then
		tracker[dad][obj] = true

		local n = 0

		for i,v in pairs(tracker[dad]) do
			n += 1
		end

		local s = ""
		while n > 0 do
			n -= 1
			s = string.char(65+n%26)..s
			n = math.floor(n/26)
		end

		obj.Name = s
	end
end

