			local gui = parent:FindFirstAncestorWhichIsA("ScreenGui")
			window,content = lib:Window(gui,text.." Settings",UDim2.new(0,260,0,0),{noscroll = true,symbol = settings.information,position = UDim2.new(0,sttg.AbsolutePosition.X,0,sttg.AbsolutePosition.Y)})

			window:SetAttribute("Floating",true)

			settings.settings(content)

			window.Size += UDim2.fromOffset(0,(#content:GetChildren() * settings.elementS) + settings.headerS - 10)
			window.Position = UDim2.new(0,sttg.AbsolutePosition.X + 22,0,sttg.AbsolutePosition.Y - #content:GetChildren() * 12)

			parent.Parent:GetPropertyChangedSignal("AbsolutePosition"):Connect(function()
				window.Position = UDim2.new(0,sttg.AbsolutePosition.X + 22,0,sttg.AbsolutePosition.Y - #content:GetChildren() * 12)
			end)
			parent.Parent:GetPropertyChangedSignal("AbsoluteRotation"):Connect(function()
				window.Position = UDim2.new(0,sttg.AbsolutePosition.X + 22,0,sttg.AbsolutePosition.Y - #content:GetChildren() * 12)
			end)
			parent.Parent:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
				window.Position = UDim2.new(0,sttg.AbsolutePosition.X + 22,0,sttg.AbsolutePosition.Y - #content:GetChildren() * 12)
			end)

			zindexthingy(window,dropdownamount + 2)
		end)

		box.Position = box.Position - UDim2.fromOffset(settings.elementS,0)
	end

	local check = Instance.new("TextLabel")
	check.BackgroundTransparency = 1
	check.Size = UDim2.fromScale(1,1)
	check.Text = "X"
	check.Font = settings.font2
	check.TextSize = 14
	check.TextColor3 = settings.checkboxfill
	check.Visible = shape:find("X") and value or false
	check.Parent = box

	local fill = Instance.new("Frame")
	fill.Visible = value
	fill.AnchorPoint = Vector2.new(.5,.5)
	fill.Position = UDim2.fromScale(.5,.5)
	fill.Size = value and UDim2.fromScale(1,1) or UDim2.fromScale(0,0)
	fill.BackgroundColor3 = settings.checkboxfill
	if shape:find("X") or animation == "fade" then
		fill.Visible = false
	else
		fill.Visible = value
	end
	fill.Parent = box

	local fillCorner = corner:Clone()
	fillCorner.Parent = fill

	check.TextTransparency = value and 0 or 1
	check.TextSize = 14

	local function refresh()
		if animation == "fill" then
			if shape:find("X") then
				check.Visible = true

				if value then
					TS:Create(check,TweenInfo.new(.15),{TextTransparency = 0,TextSize = 14}):Play()
				else
					local t = TS:Create(check,TweenInfo.new(.15),{TextTransparency = 1,TextSize = 6})
					t:Play()
					t.Completed:Connect(function() check.Visible = false end)
				end
			else
				fill.Visible = true

				if value then
					TS:Create(fill,TweenInfo.new(.15),{Size = UDim2.fromScale(1,1)}):Play()
				else
					local t = TS:Create(fill,TweenInfo.new(.15),{Size = UDim2.fromScale(0,0)})
					t:Play()
					t.Completed:Connect(function() fill.Visible = false end)
				end
			end
		elseif animation == "fade" then
			local t = nil
			if shape:find("X") then
				t = TS:Create(check,TweenInfo.new(.15),{TextTransparency = value and 0 or 1})
			else
				t = TS:Create(box,TweenInfo.new(.15),{BackgroundColor3 = value and settings.checkboxfill or settings.checkbox})
			end
			t:Play()
			if not shape:find("X") then
				for i,v in pairs(box:GetChildren()) do
					if v:IsA("UIStroke") then
						v.Transparency = value and 1 or 0
					end
				end
			end
			if not value then t.Completed:Wait() end
			if shape:find("X") then check.Visible = value end
		else
			local t = nil
			if shape:find("X") then
				t = TS:Create(check,TweenInfo.new(.15),{TextTransparency = value and 0 or 1})
			else
				t = TS:Create(box,TweenInfo.new(.15),{BackgroundColor3 = value and settings.checkboxfill or settings.checkbox})
			end
			t:Play()
			if not shape:find("X") then
				for i,v in pairs(box:GetChildren()) do
					if v:IsA("UIStroke") then
						v.Transparency = value and 1 or 0
					end
				end
			end
			if not value then t.Completed:Wait() end
			check.Visible = value
		end
	end

	refresh()

	if settings.callback and not settings.nocall then settings.callback(value) end

	box.MouseButton1Click:Connect(function()
		value = not value
		refresh()
		if settings.callback then settings.callback(value) end
	end)

	track(parent,row)

	return row,{
		get = function() return value end,
		set = function(v)
			value = v and true or false
			refresh()
			if settings.callback then settings.callback(v) end
		end,
	}
end

