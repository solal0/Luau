function lib:Slider(parent,text,def,min,max,settings)
	settings = clean(settings or {})

	if not settings.nocheck then
		if check(parent,text,def,min,max) then
			return
		end
	end

	if max < min then
		warn(err,"Argument #4 (maximum) must be greater than Argument #5 (minimum)")
		return
	end

	if def < min or def > max then
		warn(err,"Argument #3 (default) must be between or equal to Argument #4 (minimum) and Argument #5 (maximum)")
		return
	end

	local speed = settings.speed or 1
	if speed <= 0 then
		warn(err,"Slider speed setting cannot be set to 0 or lower. Speed has been set to 1.")
		speed = 1
	end

	local barStyle = settings.barstyle or "smooth"
	local cursorStyle = settings.cursorstyle or "round"

	local value = def
	def = (def - min) / (max - min)

	local row = Instance.new("Frame")
	row.Size = UDim2.new(1,0,0,settings.elementS)
	row.BackgroundTransparency = 1
	row.Parent = parent

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(.35,0,1,0)
	label.BackgroundTransparency = 1
	label.Font = settings.font0
	label.TextSize = 13
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextColor3 = settings.text1
	label.Text = "  " .. text
	label.Parent = row

	local valueDisplay = nil
	if not settings.nodisplay then
		valueDisplay = Instance.new("TextBox")
		valueDisplay.Size = UDim2.new(0,32,0,20)
		valueDisplay.Position = UDim2.new(.5,-28,0,3)
		valueDisplay.BackgroundColor3 = settings.colorpickerbox
		valueDisplay.Font = settings.font0
		valueDisplay.TextSize = 12
		valueDisplay.PlaceholderText = min.." - "..max
		valueDisplay.Text = value
		valueDisplay.TextColor3 = settings.text1
		valueDisplay.ClearTextOnFocus = false
		valueDisplay.Parent = row

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0,4)
		corner.Parent = valueDisplay

		outline(valueDisplay,.5,.5,true)

		if settings.hoverLabel then
			hoverLabel(parent, valueDisplay, "About "..text, settings.hoverLabel, settings)
		end

		local cur
		valueDisplay.Focused:Connect(function()
			cur = valueDisplay.Text
		end)

		valueDisplay.FocusLost:Connect(function()
			local new = tonumber(valueDisplay.Text)
			if not new then
				valueDisplay.Text = cur
			elseif new <= max and new >= min then
				if settings.callback then settings.callback(tonumber(new)) end
			elseif new > max then
				if settings.callback then settings.callback(tonumber(max)) end
				valueDisplay.Text = max
			elseif new < min then
				if settings.callback then settings.callback(tonumber(min)) end
				valueDisplay.Text = min
			else
				valueDisplay.Text = cur
			end
		end)
	end

	local bar = Instance.new("Frame")
	bar.Size = UDim2.new(.43,0,0,4)
	bar.Position = UDim2.new(.55,0,.5,-2)
	bar.BackgroundColor3 = settings.slider
	bar.Parent = row

	outline(bar,.5,.5,true)

	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(def,1)
	fill.BackgroundColor3 = settings.sliderfill
	fill.Parent = bar

	if barStyle == "smooth" then
		local barCorner = Instance.new("UICorner")
		barCorner.CornerRadius = UDim.new(0,4)
		barCorner.Parent = bar

		local fillCorner = barCorner:Clone()
		fillCorner.Parent = fill
	end

	local cursor = Instance.new("ImageLabel")
	cursor.AnchorPoint = Vector2.new(.5,.5)
	cursor.Position = UDim2.fromScale(def,cursorStyle == "spike" and -.5 or .5)
	cursor.BackgroundColor3 = settings.slidercursor
	cursor.ImageTransparency = 1
	cursor.Parent = bar

	if settings.hoverLabel then
		hoverLabel(parent, row, "About "..text, settings.hoverLabel, settings)
		hoverLabel(parent, label, "About "..text, settings.hoverLabel, settings)
		hoverLabel(parent, bar, "About "..text, settings.hoverLabel, settings)
		hoverLabel(parent, fill, "About "..text, settings.hoverLabel, settings)
		hoverLabel(parent, cursor, "About "..text, settings.hoverLabel, settings)
	end

	if cursorStyle == "round" then
		cursor.Size = UDim2.new(0,10,0,10)
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(1,0)
		c.Parent = cursor
		--outline(cursor,.5,.5,true)
	elseif cursorStyle == "square" then
		cursor.Size = UDim2.new(0,8,0,8)
		--outline(cursor,.5,.5,true)
	elseif cursorStyle == "bar" then
		cursor.Size = UDim2.new(0,4,0,14)
		--outline(cursor,.5,.5,true)
	elseif cursorStyle == "spike" then
		cursor.Size = UDim2.new(0,14,0,14)
		cursor.BackgroundTransparency = 1
		cursor.ImageTransparency = 0
		cursor.Rotation = 135
		cursor.Image = "rbxassetid://140571460844683"
	end

	local dragging = false
	local last = 0

	local function snap(v)
		return math.floor(v / speed + .5) * speed
	end

	local function setFromX(x)
		value = string.format("%.2f",math.clamp(snap(min + (max - min) * math.clamp(x / bar.AbsoluteSize.X,0,1)),min,max))
		local snappedAlpha = (value - min) / (max - min)
		if valueDisplay then valueDisplay.Text = value % 1 ~= 0 and value or math.floor(value) end
		TS:Create(fill,TweenInfo.new(.1),{Size = UDim2.fromScale(snappedAlpha,1)}):Play()
		TS:Create(cursor,TweenInfo.new(.1),{Position = UDim2.fromScale(snappedAlpha,cursorStyle == "spike" and -.5 or .5)}):Play()
		if last ~= value and settings.callback then settings.callback(tonumber(value)) end
		last = value
	end

	bar.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			setFromX(i.Position.X - bar.AbsolutePosition.X)
		end
	end)

	UIS.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)

	UIS.InputChanged:Connect(function(i)
		if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
			setFromX(i.Position.X - bar.AbsolutePosition.X)
		end
	end)

	if settings.callback and not settings.nocall then settings.callback(tonumber(value)) end

	track(parent,row)

	return row,{
		get = function() return value end,
		set = function(v)
			value = math.clamp(snap(v),min,max)
			local alpha = (value - min) / (max - min)
			valueDisplay.Text = tostring(value)
			fill.Size = UDim2.fromScale(alpha,1)
			cursor.Position = UDim2.fromScale(alpha,.5)
			if settings.callback then settings.callback(tonumber(value)) end
		end
	}
end

