	head.MouseButton1Click:Connect(function()
		collapse(open)
	end)

	local function update()
		frame.Size = UDim2.new(0,head.AbsoluteSize.X,0,height < 200 and height + 16 or 200)
		frame.Position = UDim2.new(0,head.AbsolutePosition.X,0,head.AbsolutePosition.Y + 78 - (frame.Parent.IgnoreGuiInset and 0 or 58))
	end
	update()

	head:GetPropertyChangedSignal("AbsolutePosition"):Connect(update)
	head:GetPropertyChangedSignal("AbsoluteRotation"):Connect(update)
	head:GetPropertyChangedSignal("AbsoluteSize"):Connect(update)

	expand.Parent = head

	if settings.hoverLabel then
		hoverLabel(parent, holder, "About "..text, settings.hoverLabel, settings)
		hoverLabel(parent, column1, "About "..text, settings.hoverLabel, settings)
		hoverLabel(parent, column2, "About "..text, settings.hoverLabel, settings)
		hoverLabel(parent, label, "About "..text, settings.hoverLabel, settings)
		hoverLabel(parent, frame, "About "..text, settings.hoverLabel, settings)
		hoverLabel(parent, stuff, "About "..text, settings.hoverLabel, settings)
	end

	local function addBtn(v)
		height += 26
		update()
		local btn = lib:Button(stuff,v,{
			callback = function()
				head.Text = "  "..v
				collapse(true)
				if settings.callback then settings.callback(v) end
			end
		})
		tableOfContent[v] = btn
		zindexthingy(frame,dropdownI)
	end

	for _,v in pairs(content) do
		addBtn(v)
	end

	if settings.callback and not settings.nocall then
		local found = false
		for _,v in pairs(content) do
			if v == settings.default then
				settings.callback(v)
				found = true
				current = v
				break
			end
		end
	end

	track(parent,head)

	dropdownI -= 1

	return frame, {
		add = function(v)
			addBtn(v)
		end,
		sub = function(v)
			local found = false
			for i,btn in pairs(tableOfContent) do
				if i == v then
					btn.Parent:Destroy()
					found = true
					break
				end
			end
			if found then
				height -= 26
				update()
				if current == v then
					current = nil
					head.Text = "  ..."
				end
				tableOfContent[v] = nil
			end
		end,
		set = function(v)
			head.Text = "  "..v
			collapse(true)
			if settings.callback then settings.callback(v) end
		end
	}
end

