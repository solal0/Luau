	expand.Size = UDim2.new(0,16,0,16)
	expand.Position = UDim2.new(1,-20,0,2)
	expand.BackgroundTransparency = 1
	expand.Image = settings.plus

	local function collapse(v)
		open = not v
		frame.Visible = not v
		expand.Image = v and settings.plus or settings.minimize
	end

