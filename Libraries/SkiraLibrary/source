		parent.Parent:GetPropertyChangedSignal("AbsoluteSize"):Connect(update)

		zindexthingy(pickerWindow,dropdownamount + 2)
	end)

	if callback and not settings.nocall then callback(color) end

	track(parent,row)

	return row,{
		get = function() return color end,
		set = function(c)
			color = c
			rBox.Text = math.floor(c.R*255)
			gBox.Text = math.floor(c.G*255)
			bBox.Text = math.floor(c.B*255)
			preview.BackgroundColor3 = c
