function lib:KeyPicker(parent,text,settings)
	settings = clean(settings or {})

	if not settings.nocheck then
		if check(parent,text) then
			return
		end
	end

	local holder = lib:Holder(parent{padding = UDim.new(0,6)})
	local column1 = lib:Column(holder,UDim2.new(1,-130,0,0),Enum.HorizontalAlignment.Left)
	local column2 = lib:Column(holder,UDim2.new(0,130,0,0),Enum.HorizontalAlignment.Right) -- biggest KeyCode is MouseMiddleButton, who fits perfectly within 130
	local label = lib:Label(column1,text,{wrapped = false})

	local button
	button = lib:Button(column2,"None",{alignmentX = Enum.TextXAlignment.Center,
		callback = function()
			local save = button.Text
			button.Text = "Press a key..."

			local key
			local connection = game:GetService("UserInputService").InputBegan:Connect(function(input)
				key = input.UserInputType ~= Enum.UserInputType.Keyboard and input.UserInputType or input.KeyCode
			end)
			repeat wait() until key

			connection:Disconnect()

			if settings.exitkey and key == settings.exitkey or key == Enum.KeyCode.Escape or key == Enum.UserInputType.Keyboard then
				button.Text = save
			elseif settings.deletekey and key == settings.deletekey then
				if settings.callback then settings.callback(Enum.KeyCode.None) end
				button.Text = "None"
			else
				if settings.callback then settings.callback(key) end
				button.Text = key.Name
			end
		end
	})

	if settings.hoverLabel then
		hoverLabel(parent, holder, "About "..text, settings.hoverLabel, settings)
		hoverLabel(parent, column1, "About "..text, settings.hoverLabel, settings)
		hoverLabel(parent, column2, "About "..text, settings.hoverLabel, settings)
		hoverLabel(parent, label, "About "..text, settings.hoverLabel, settings)
		hoverLabel(parent, button, "About "..text, settings.hoverLabel, settings)
	end

	button.Text = settings.key and settings.key.Name or "None"

	return button,{
		set = function(key)
			button.Text = key.Name
			if settings.callback then settings.callback(key) end
		end
	}
end

