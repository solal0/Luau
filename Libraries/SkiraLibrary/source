function lib:Theme(base,brightness)
	brightness = brightness or 0

	local bh,bs,bv = base:ToHSV()

	local function map(color)
		local _,s,v = color:ToHSV()
		s = math.max(s,bs * (1 - v))
		v = math.clamp(v + brightness / 255 + 0.035,0,1)
		return Color3.fromHSV(bh,s,v)
	end

	local cfg = {}
	for i,v in pairs(config) do
		cfg[i] = typeof(v) == "Color3" and map(v) or v
	end

	return cfg
end

function lib:Begin(parent,name,cfg) -- v0.0.0
	if check(name) then return end

	local enabled = (cfg and cfg.enabled) ~= false
	local noguiset = (cfg and cfg.noguiset) ~= false
	local resetonspawn = cfg and cfg.resetonspawn or false

	local window = Instance.new("ScreenGui")
	window.Parent = parent
	window.Enabled = enabled
	window.IgnoreGuiInset = noguiset
	window.ResetOnSpawn = resetonspawn

	if name == "random" then
		window.Name = game:GetService("HttpService"):GenerateGUID(false):sub(1,math.random(10,200))
	else
		window.Name = name
	end

	if cfg and cfg ~= {} then
		for i,v in pairs(cfg) do
			config[i] = v
		end
	end

	--began = true -- removed in 1.5.9

	return window, config
end

function lib:Window(parent,title,size,settings) -- v0.0.1, creation; v0.0.3, renamed to lib:Window
	settings = clean(settings or {})

	if not settings.nocheck then
		if check(parent,title,size) then
			return
		end
	end

	local collapsable = settings.collapsable ~= false
