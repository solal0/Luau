	end
	return settings
end

function outline(obj,v1,v2,inner,settings)
	local config = settings or config

	local stroke = Instance.new("UIStroke")
	stroke.Color = config.outline0
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	if v1 then stroke.Transparency = v1 end
	stroke.Thickness = 1
	stroke.Parent = obj

	local innerStroke = Instance.new("UIStroke")
	innerStroke.Color = config.outline1
	innerStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	innerStroke.BorderStrokePosition = Enum.BorderStrokePosition.Inner
	if v2 then innerStroke.Transparency = v2 end
	innerStroke.Parent = obj

	if inner then
		stroke.BorderStrokePosition = Enum.BorderStrokePosition.Inner
		innerStroke.Thickness = 2
		stroke.ZIndex = 2
	end
end

