	local Xresizable = settings.Xresizable ~= false
	local Yresizable = settings.Yresizable ~= false
	local isdropdown = settings.isdropdown or false
	local draggable = settings.draggable ~= false
	local noheader = settings.noheader or false
	local noscroll = settings.noscroll or false
	local closable = settings.closable ~= false
	local nobar = settings.nobar or false
	local icon = settings.symbol or nil

	local api = {collapse = function(v) end,symbol = nil,set = nil,close = nil}

	local frame = Instance.new("Frame")
	frame.Size = size
	frame.Position = settings.position or UDim2.new(0,0,0,0)
	frame.BackgroundColor3 = ishoverlabel and Color3.new(1,1,1) or settings.background
	frame.ClipsDescendants = true
	frame.BorderSizePixel = ishoverlabel and 2 or 0

	if ishoverlabel then
		frame.BorderColor3 = Color3.new(0,0,0)
	else
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0,6)
		corner.Parent = frame

		outline(frame,isdropdown and .5 or 0,isdropdown and .5 or 0,isdropdown and true or false)
	end

	local header = Instance.new("Frame")
	header.Name = "Header"
	header.Size = UDim2.new(1,0,0,isdropdown and settings.objectS or settings.headerS)
	header.BackgroundColor3 = settings.header

	if not noheader then header.Parent = frame end

	local headerCorner = Instance.new("UICorner")
	headerCorner.CornerRadius = UDim.new(0,6)
	headerCorner.Parent = header

	local fix = Instance.new("Frame")
	fix.BorderSizePixel = 0
	fix.Size = UDim2.new(1,0,0,6)
	fix.Position = UDim2.new(0,0,1,-6)
	fix.BackgroundColor3 = settings.header
	fix.Parent = header

	if isdropdown then
		frame.Size = UDim2.new(1,0,size.Y.Scale,size.Y.Offset)
		header.BackgroundTransparency = 1
		fix.BackgroundTransparency = 1
	end

	local leftPadding = 10
	local max = 0

	if icon and icon ~= "" then
		max += 28
		local image = Instance.new("ImageLabel")
		image.BackgroundTransparency = 1
		image.Size = UDim2.new(0,20,0,20)
		image.Position = UDim2.new(0,5,.5,-10)
		image.ImageColor3 = settings.icon
		image.Image = icon
		image.Parent = header
		leftPadding = 30
		api.symbol = image
	end

	local titleLabel = Instance.new("TextLabel")
	titleLabel.BackgroundTransparency = 1
	titleLabel.Position = UDim2.new(0,leftPadding,0,0)
	titleLabel.Size = UDim2.new(1,-70,1,0)
	titleLabel.Font = settings.font1
	titleLabel.Text = title or ""
	titleLabel.TextColor3 = isdropdown and settings.text1 or settings.text0
	titleLabel.TextSize = isdropdown and settings.textS or settings.titleS
	titleLabel.TextXAlignment = Enum.TextXAlignment.Left
	titleLabel.Parent = header

	api.set = function(b) titleLabel.Text = b end

	local content = nil
	if noscroll then
		content = Instance.new("Frame")
	else
		content = Instance.new("ScrollingFrame")
		content.ScrollBarThickness = 0
		content.ScrollBarImageColor3 = settings.scrollbar
	end
	content.Name = "Content"
	content.BorderSizePixel = 0
	content.BackgroundTransparency = 1
	content.Position = UDim2.new(0,8,0,noheader and 8 or isdropdown and 20 or 36)
	content.Size = UDim2.new(1,-16,1,noheader and -16 or isdropdown and -24 or -44)
	content.Parent = frame

	local list = Instance.new("UIListLayout")
	list.SortOrder = Enum.SortOrder.Name
	list.Parent = content

	if not noscroll then
		list:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
			content.CanvasSize = UDim2.new(0,0,0,list.AbsoluteContentSize.Y)
		end)
	end

	local collapsebutton = nil
	local oldSize = isdropdown and settings.size and settings.size.value or frame.Size
	local minimized = false
	local hovered = false
	local off = 0

	local function collapse(v)
		if collapsebutton then collapsebutton.Image = v and settings.plus or settings.minimize end
		minimized = v
		if v then
			fix.Visible = false
			content.Visible = false
			TS:Create(frame,TweenInfo.new(.18,Enum.EasingStyle.Quad),{Size = UDim2.new(frame.Size.X.Scale,frame.Size.X.Offset,frame.Size.Y.Scale,isdropdown and settings.objectS or 28)}):Play()
		else
			fix.Visible = true
			content.Visible = true
			TS:Create(frame,TweenInfo.new(.18,Enum.EasingStyle.Quad),{Size = isdropdown and settings.size and settings.size.value or oldSize}):Play()
		end
	end

	api.collapse = function(v) collapse(v) end

	if settings.collapsed ~= nil then collapse(settings.collapsed) end

	local function headerButton(symbol,callback)
		max += 28

		local hovering = false

		local button = Instance.new("ImageButton")
		button.BackgroundTransparency = 1
		button.Size = UDim2.new(0,18,0,18)
		button.Position = UDim2.new(1,-24 - off,.5,-9)
		button.ImageColor3 = settings.button0
		button.Image = symbol
		button.Parent = header

		button.MouseEnter:Connect(function()
			hovering = true
			button.ImageColor3 = settings.button0hover
		end)

		button.MouseLeave:Connect(function()
			hovering = false
			button.ImageColor3 = settings.button0
		end)

		button.MouseButton1Down:Connect(function()
			button.ImageColor3 = settings.button0active
		end)

		button.MouseButton1Up:Connect(function()
			button.ImageColor3 = hovering and settings.button0hover or settings.button0
		end)

		button.MouseButton1Click:Connect(callback)

		off += settings.objectS

		if symbol ~= settings.close then
			collapsebutton = button
		end

		return button
	end

	local function close()
		if settings.callback then settings.callback("closing") end
		local tween = TS:Create(frame,TweenInfo.new(.18,Enum.EasingStyle.Quad),{Size = UDim2.new(0,frame.AbsoluteSize.X,0,0),BackgroundTransparency = 1})
		tween:Play()
		tween.Completed:Connect(function()
			frame:Destroy()
			if settings.callback then settings.callback("closed") end
		end)
	end

	if closable then
		headerButton(settings.close,function()
			close()
		end)
	end

	api.close = function() close() end

	if collapsable then
		local button
		button = headerButton(if settings.collapsed then settings.plus else settings.minimize,function() collapse(not minimized,button) end)
	end

	if draggable then
		local dragging = false
		local dragStart
		local startPos

		header.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				dragging = true
				dragStart = input.Position
				startPos = frame.Position
			end
		end)

		UIS.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				dragging = false
			end
		end)

		UIS.InputChanged:Connect(function(input)
			if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
				local delta = input.Position - dragStart
				frame.Position = UDim2.new(startPos.X.Scale,startPos.X.Offset + delta.X,startPos.Y.Scale,startPos.Y.Offset + delta.Y)
			end
		end)
	end

	local function resize(side)
		local line = Instance.new("Frame")
		line.BackgroundColor3 = settings.scalebar
		line.BackgroundTransparency = 1
		line.Parent = frame

		local gradient = Instance.new("UIGradient")
		gradient.Parent = line
		gradient.Transparency = NumberSequence.new{NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(.5,0),NumberSequenceKeypoint.new(1,1)}

		if side == "Right" then
			gradient.Rotation = 90
			line.Size = UDim2.new(0,2,1,0)
			line.Position = UDim2.new(1,-1,0,0)
		elseif side == "Bottom" then
			line.Size = UDim2.new(1,0,0,2)
			line.Position = UDim2.new(0,0,1,-1)
		end

		local resizing = false
		local startMouse
		local startSize

		line.MouseEnter:Connect(function()
			if not minimized then
				TS:Create(line,TweenInfo.new(.1),{BackgroundTransparency = 0}):Play()
			end
		end)

		line.MouseLeave:Connect(function()
			if not resizing and not minimized then
				TS:Create(line,TweenInfo.new(.1),{BackgroundTransparency = 1}):Play()
			end
		end)

		line.InputBegan:Connect(function(i)
			if not minimized and i.UserInputType == Enum.UserInputType.MouseButton1 then
				resizing = true
				startMouse = i.Position
				startSize = frame.Size
			end
		end)

		UIS.InputEnded:Connect(function(i)
			if not minimized and i.UserInputType == Enum.UserInputType.MouseButton1 then
				resizing = false
				TS:Create(line,TweenInfo.new(.1),{BackgroundTransparency = 1}):Play()
			end
		end)

		UIS.InputChanged:Connect(function(i)
			if resizing and i.UserInputType == Enum.UserInputType.MouseMovement then
				local delta = i.Position - startMouse

				local x = startSize.X.Offset
				local y = startSize.Y.Offset

				if side == "Right" then
					x += delta.X
				elseif side == "Bottom" then
					y += delta.Y
				end

				frame.Size = UDim2.new(0,math.max(x,max),0,math.max(y,28))
				oldSize = frame.Size
			end
		end)
	end

	if not nobar and not noscroll then
		content.MouseEnter:Connect(function()
			hovered = true
			local t = TS:Create(content,TweenInfo.new(.1),{ScrollBarThickness = 4})
			t:Play()
			t.Completed:Wait()
			if not hovered then
				content.ScrollBarThickness = 4
			end
		end)

		content.MouseLeave:Connect(function()
			hovered = false
			local t = TS:Create(content,TweenInfo.new(.1),{ScrollBarThickness = 0})
			t:Play()
			t.Completed:Wait()
			if hovered then
				content.ScrollBarThickness = 4
			end
		end)
	end

	if Xresizable then resize("Right") end
	if Yresizable then resize("Bottom") end

	frame.Parent = parent

	tracker[content] = {}

	return frame,content,api
end

function hoverLabel(parent, obj, text, text2, settings)
	local window, frame = lib:Window(parent:FindFirstAncestorOfClass("ScreenGui"),text,UDim2.new(0,150,0,100),{nocheck = true,symbol = config.information,collapsable = false,closable = false,draggable = false,noscroll = true,noheader = true})
	window.Name = "HoverLabel"

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Text = text2
	label.TextColor3 = settings.text1
	label.Font = settings.font0
	label.TextWrapped = true
	label.TextScaled = true
	label.RichText = true
	label.Parent = frame

	local elements = {}

	for i,v in pairs(window:GetDescendants()) do
		if v:IsA("TextLabel") then
			elements[v] = v.TextTransparency
		elseif v:IsA("Frame") then
			elements[v] = v.BackgroundTransparency
		elseif v:IsA("UIStroke") then
			elements[v] = v.Transparency
		end
	end

	for v,transparency in pairs(elements) do
		if v:IsA("TextLabel") then
			v.TextTransparency = 1
		elseif v:IsA("Frame") then
			v.BackgroundTransparency = 1
		elseif v:IsA("UIStroke") then
			v.Transparency = 1
		end
	end

	local m = game.Players.LocalPlayer:GetMouse()
	m.Move:Connect(function()
		local Y = m.Y+81 - (window.Parent.IgnoreGuiInset and 0 or 58)
		window.Position = UDim2.new(0,m.X,0,Y)
	end)

	window.Visible = false
	local hovering = false
	local hoverId = 0

	obj.MouseEnter:Connect(function()
		hovering = true
		hoverId += 1
		local id = hoverId

		task.spawn(function()
			task.wait(.1)

			if not hovering or id ~= hoverId then
				return
			end

			window.Visible = true

			for i,v in pairs(window:GetDescendants()) do
				if not elements[v] then continue end

				if v:IsA("TextLabel") then
					game.TweenService:Create(v,TweenInfo.new(.2),{TextTransparency = elements[v]}):Play()
				elseif v:IsA("Frame") then
					game.TweenService:Create(v,TweenInfo.new(.2),{BackgroundTransparency = elements[v]}):Play()
				elseif v:IsA("UIStroke") then
					v.Transparency = elements[v]
				end
			end

			game.TweenService:Create(window,TweenInfo.new(.2),{BackgroundTransparency = 0}):Play()
		end)
	end)

	obj.MouseLeave:Connect(function()
		hovering = false
		hoverId += 1

		for i,v in pairs(window:GetDescendants()) do
			if v:IsA("UIStroke") then
				v.Transparency = 1
				continue
			end

			pcall(function()
				game.TweenService:Create(v,TweenInfo.new(.2),{BackgroundTransparency = 1}):Play()
				game.TweenService:Create(v,TweenInfo.new(.2),{TextTransparency = 1}):Play()
			end)
		end

		local id = hoverId
		local t = game.TweenService:Create(window,TweenInfo.new(.2),{BackgroundTransparency = 1})
		t:Play()
		t.Completed:Wait()

		if id == hoverId and not hovering then
			window.Visible = false
		end
	end)
end

