function data.GetKey(Name:string,Outline:boolean?):{Url:string,Vector:Vector2}
	local i = data.All["None"]
	if Name:find("Outline") or not (Outline or data.AllUseOutline) then
		i = data.All[Name] or data.KeyCode[Name] or data.UserInputType[Name]
	elseif Outline or data.AllUseOutline then
		local v = "Outline"
		i = data.All[Name..v] or data.KeyCode[Name..v] or data.UserInputType[Name..v] or data.All["None"..v]
	end
	return {Url = i[1], Vector = i[2]}
end

function data.SetImage(Image:Instance,Name:string,Outline:boolean?)
	local icon = type(Name) == "table" and Name or data.GetKey(Name,Outline)
	Image.ImageRectSize = Vector2.new(64,64)
	Image.ImageRectOffset = icon.Vector
	Image.Image = icon.Url
end

return data
