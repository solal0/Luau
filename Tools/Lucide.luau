function data.GetIcon(Name:string):{Url:string,Vector:Vector2}
	local i = data.Icons[Name]
	return i and {Url = i[1], Vector = i[2]} or nil
end

function data.SetImage(Image:Instance,Name:string)
	local icon = type(Name) == "table" and Name or data.GetIcon(Name)
	if icon then
		Image.ImageRectSize = Vector2.new(64,64)
		Image.ImageRectOffset = icon.Vector
		Image.Image = icon.Url
	else
		warn(`Could not find {Name}`)
		Image.Image = ""
	end
end

return data
